# ── Seguridad ────────────────────────────────────────────────────────────────
# Secreto compartido para los workflows de Elevator (ingesta) y el formulario SAC.
TRACKING_API_SECRET=
# Secreto Bearer para los crons de Vercel.
CRON_SECRET=

# ── Zona horaria / moneda del reporte ────────────────────────────────────────
# Offset horario de la clínica para calcular el "día". CDMX y Costa Rica = -6.
CLINIC_UTC_OFFSET_HOURS=-6
REPORT_CURRENCY=MXN

# ── Supabase (capa analítica) ────────────────────────────────────────────────
# Si faltan, la app NO falla: la persistencia hace no-op y los conteos quedan en null.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Sheets (espejo legible) ───────────────────────────────────────────
# Web App de Google Apps Script que hace appendRow. Ver README §Google Sheets.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# ── WhatsApp vía Elevator / GoHighLevel ──────────────────────────────────────
# Webhook entrante de un workflow de Elevator/GHL que envía el WhatsApp a los dueños.
ELEVATOR_WHATSAPP_WEBHOOK_URL=
ELEVATOR_WHATSAPP_WEBHOOK_SECRET=
# Números de los dueños (E.164), separados por coma. Ej: +5215512345678,+5215598765432
OWNER_WHATSAPP_NUMBERS=

# ── Windsor (impresiones / clics / spend) ────────────────────────────────────
WINDSOR_API_KEY=
WINDSOR_BASE_URL=https://connectors.windsor.ai/
WINDSOR_CONNECTOR=all
WINDSOR_FIELDS=source,campaign,spend,clicks,impressions,reach
# Filtro de texto para aislar DrDiente si la cuenta Windsor es multi-cliente.
WINDSOR_INCLUDE_TEXT=
WINDSOR_EXCLUDE_TEXT=
