{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "cierre.clinicadrdiente.com" }],
      "destination": "/cierre.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/payments-sync",
      "schedule": "0 5 * * *"
    }
  ]
}
