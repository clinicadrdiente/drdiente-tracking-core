{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/**/*.ts": { "maxDuration": 60, "includeFiles": "static/owner-demo-data.json" }
  },
  "crons": [
    {
      "path": "/api/cron/payments-sync",
      "schedule": "0 5 * * *"
    }
  ]
}
