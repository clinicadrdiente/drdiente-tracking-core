ELEVATOR_MODE=stub
ELEVATOR_BASE_URL=https://api.elevator.example
ELEVATOR_API_KEY=replace-me
ELEVATOR_CONTACTS_PATH=/contacts
ELEVATOR_SEARCH_PATH=/contacts/search
ELEVATOR_STAGE_PATH_TEMPLATE=/contacts/{id}/stage
ELEVATOR_ID_FIELD=id
ELEVATOR_PHONE_FIELD=phone
ELEVATOR_EMAIL_FIELD=email
ELEVATOR_BRANCH_FIELD=branch
ELEVATOR_FIRST_NAME_FIELD=first_name
ELEVATOR_LAST_NAME_FIELD=last_name
ELEVATOR_STAGE_FIELD=stage
ELEVATOR_ATTRIBUTION_FIELD_PREFIX=attr_
# Optional: nest attribution fields under a single object key on the contact
# (e.g. GoHighLevel custom fields). Leave empty to write/read them flat.
ELEVATOR_ATTRIBUTION_CONTAINER=
# Inbound Webhook URL from an Elevator (GHL) workflow — forwards Purchase/Refund to Meta+Google.
# Create in Elevator: Automation → Workflows → New → trigger "Inbound Webhook" → copy URL here.
# Leave empty to disable (stub mode — Stape still sends all events).
ELEVATOR_EVENTS_WEBHOOK_URL=
DENTALINK_MODE=stub
DENTALINK_BASE_URL=https://api.dentalink.healthatom.com/api/v1/
DENTALINK_API_TOKEN=replace-me
DENTALINK_API_AUTH_SCHEME=Token
DENTALINK_PATIENTS_PATH_TEMPLATE=/pacientes/{id}
DENTALINK_PAYMENTS_PATH=/pagos/
DENTALINK_TREATMENTS_PATH_TEMPLATE=/tratamientos/{id}
DENTALINK_PATIENT_UPDATE_PATH_TEMPLATE=/pacientes/{id}
DENTALINK_PATIENT_ID_FIELD=id
DENTALINK_PATIENT_FIRST_NAME_FIELD=nombre
DENTALINK_PATIENT_LAST_NAME_FIELD=apellido
DENTALINK_PATIENT_PHONE_FIELD=telefono
DENTALINK_PATIENT_EMAIL_FIELD=email
DENTALINK_PATIENT_BRANCH_FIELD=sucursal
DENTALINK_PAYMENT_ID_FIELD=id
DENTALINK_PAYMENT_PATIENT_ID_FIELD=id_paciente
DENTALINK_PAYMENT_TREATMENT_ID_FIELD=id_tratamiento
DENTALINK_PAYMENT_AMOUNT_FIELD=monto
DENTALINK_PAYMENT_VOIDED_FIELD=anulado
DENTALINK_PAYMENT_DATE_FIELD=fecha
DENTALINK_TREATMENT_ID_FIELD=id
DENTALINK_TREATMENT_BUDGET_TOTAL_FIELD=valor_total
DENTALINK_TREATMENT_NAME_FIELD=nombre
DENTALINK_ADDITIONAL_FIELDS_CONTAINER=campos_adicionales
DENTALINK_ELEVATOR_ID_FIELD=elevator_id
HIGH_TICKET_THRESHOLD=50000
PAYMENTS_SYNC_LOOKBACK_MINUTES=15
DEFAULT_CURRENCY=MXN

# Stape sGTM — REQUIRED for purchase events to actually be sent. With STAPE_MODE
# unset/stub the client is a no-op and every "Compra" is silently dropped.
STAPE_MODE=stub
STAPE_SERVER_URL=https://your-container.stape.io
STAPE_REQUEST_PATH=/data
STAPE_CONTAINER_ID=
STAPE_CONTAINER_IDENTIFIER=
STAPE_API_KEY=
STAPE_API_KEY_HEADER=x-stape-api-key
# CSV hint included in every Stape payload so the GTM container can filter tags by platform.
# Example: STAPE_TARGET_PLATFORMS=tiktok  (set once Meta+Google move to Elevator)
# Leave empty to send to all platforms configured in the container (current default).
STAPE_TARGET_PLATFORMS=

# Windsor.ai — spend/delivery truth. Key is account-level (reads every client in
# the account) -> keep server-side only, never expose in the frontend.
WINDSOR_API_KEY=
WINDSOR_BASE_URL=https://connectors.windsor.ai
WINDSOR_DEFAULT_CONNECTOR=all
WINDSOR_DATE_PRESET=last_180d
WINDSOR_DEFAULT_FIELDS=
# Multi-client isolation (Rimas + DrDiente share one account). Prefer scoping to
# the DrDiente account id/name; all_conversions is quarantined automatically.
WINDSOR_INCLUDE_TEXT=
WINDSOR_EXCLUDE_TEXT=

# Blog content report (api/dev/blog-report). Reads the public sitemap, counts
# posts under BLOG_PATH_PREFIX and joins organic metrics from the Windsor
# `searchconsole` connector when WINDSOR_API_KEY is set.
BLOG_SITEMAP_URL=https://www.clinicadrdiente.com/sitemap.xml
BLOG_PATH_PREFIX=/blog-drdiente/

# State store. On Vercel `file` uses an ephemeral tmp dir and loses the
# processed-payment set between runs (re-dispatches). Use `redis` in production.
# PRODUCTION: use STATE_STORE_MODE=redis on Vercel. file mode loses state on cold start.
STATE_STORE_MODE=file
STATE_STORE_FILE_PATH=.runtime/payment-sync-state.json
STATE_STORE_REDIS_KEY_PREFIX=drdiente:tracking
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TRACKING_API_SECRET=replace-me
# Required on Vercel: protects the cron endpoint from unauthenticated triggers.
CRON_SECRET=your-long-random-secret-here

# --- Dashboard del Cliente (api/client/*) — SEPARADO del TRACKING_API_SECRET ---
# Login real del cliente (una credencial). El cliente NO usa TRACKING_API_SECRET.
# CLIENT_PASSWORD_HASH = sha256 hex de la contraseña, p.ej.:
#   node -e "console.log(require('crypto').createHash('sha256').update('LA_CONTRASENA').digest('hex'))"
CLIENT_USERNAME=cliente
CLIENT_PASSWORD_HASH=
# Secreto largo y aleatorio para firmar la sesión (HMAC). Marcar Sensitive en Vercel.
CLIENT_SESSION_SECRET=
# El snapshot del cliente vive en el state store: usa STATE_STORE_MODE=redis en
# producción para que persista entre invocaciones (igual que el payment sync).
